{
  "name": "calm-command-center",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "vite build && npm run prerender:seo",
    "build:check": "npm run typecheck && npm run build",
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1 --open /",
    "lint": "node scripts/lint-source.mjs",
    "prerender:seo": "node scripts/prerender-seo.mjs",
    "preview": "vite preview --host 127.0.0.1 --open /",
    "serve": "npm run preview",
    "start": "npm run dev:local",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "validate:performance": "node scripts/validate-performance.mjs",
    "validate:seo": "node scripts/validate-seo.mjs"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.6.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.18.13",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "4.1.12",
    "typescript": "^5.8.3",
    "vite": "^8.0.10"
  }
}
